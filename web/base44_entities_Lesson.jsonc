{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "title": "CEFR Level"
    },
    "reading_text": {
      "type": "string",
      "title": "Reading Text"
    },
    "listening_script": {
      "type": "string",
      "title": "Listening Script (TTS)"
    },
    "writing_prompt": {
      "type": "string",
      "title": "Writing Prompt"
    },
    "speaking_instructions": {
      "type": "string",
      "title": "Speaking Instructions"
    },
    "key_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Key Vocabulary"
    },
    "student_profile_id": {
      "type": "string",
      "title": "Student Profile ID"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Activities (10)"
    },
    "activities_completed": {
      "type": "number",
      "default": 0,
      "title": "Activities Completed"
    },
    "activities_passed": {
      "type": "number",
      "default": 0,
      "title": "Activities Passed"
    },
    "mastered": {
      "type": "boolean",
      "default": false,
      "title": "Mastered (7/10+)"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "title": "Completed (all attempted)"
    },
    "audio_accent": {
      "type": "string",
      "enum": [
        "us",
        "uk",
        "aus"
      ],
      "default": "us",
      "title": "Audio Accent"
    }
  },
  "required": [
    "title",
    "level"
  ]
}